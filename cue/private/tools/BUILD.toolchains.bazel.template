load(
    "{toolchain_bzl}",
    "{tool_name}_runtime_binary",
)

_PLATFORMS = {platforms}

[
    config_setting(
        name = name,
        constraint_values = platform["constraint_values"],
    )
    for name, platform in _PLATFORMS.items()
]

[
    toolchain(
        name = "toolchain_" + name,
        exec_compatible_with = platform["constraint_values"],
        toolchain = platform["toolchain"],
        toolchain_type = "{toolchain_type}",
    )
    for name, platform in _PLATFORMS.items()
]

[
    toolchain(
        name = "runtime_toolchain_" + name,
        target_compatible_with = platform["constraint_values"],
        toolchain = platform["toolchain"],
        toolchain_type = "{runtime_toolchain_type}",
    )
    for name, platform in _PLATFORMS.items()
]

{tool_name}_runtime_binary(
    name = "{tool_name}",
    target_compatible_with = select({
        ":" + name: []
        for name in _PLATFORMS.keys()
    } | {
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["{alias_visibility}"],
)
