load(
    "{containing_package_prefix}:toolchain.bzl",
    "cue_tool",
    "cue_toolchain",
)

alias(
    name = "binary",
    actual = "cue{extension}",
    visibility = ["@{toolchains_repo}//:__pkg__"],
)

cue_tool(
    name = "tool",
    binary = ":binary",
    version = "{version}",
)

cue_toolchain(
    name = "toolchain",
    tool = ":tool",
)
